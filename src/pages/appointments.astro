---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
---
<Base
  title="Termin buchen"
  description="Buche online deinen Termin im Keramikstudio Lieblingsstück in Dormagen. 3 Stunden Malzeit, Abholung nach ca. 2–3 Wochen. Events bitte vorab anfragen."
>
  <PageHero eyebrow="Terminbuchung">
    Plane deine <em>kreative Auszeit.</em>
    <Fragment slot="lead">Für deine Malzeit im Studio hast du 3 Stunden Zeit. Such dir online deinen Wunschtermin aus.</Fragment>
  </PageHero>

  <section class="section" style="padding-top:0" aria-label="Buchung">
    <div class="container split">
      <div class="stack split__sticky" style="--stack:var(--space-5)">
        <div class="notice reveal">
          <h2>Wichtig</h2>
          <ul class="check-list" style="margin-top:.5rem">
            <li>Für Events (z. B. Geburtstage, JGAs, Firmenevents) bitten wir dich, vorab eine <a href="/events#anfrage">Anfrage</a> zu stellen.</li>
            <li>Bitte bei der Buchung die Personenanzahl angeben.</li>
            <li>Die Keramiken sind nach 2–3 Wochen mit Abholschein oder Foto abholbereit.</li>
            <li>Bitte Verpackungsmaterial beim Abholen mitbringen.</li>
          </ul>
        </div>
      </div>

      <div class="booking reveal">
        <h2 style="font-size:var(--fs-h3)">Online buchen</h2>
        <p>Wähle im Buchungssystem deinen Wunschtermin. Du wirst dafür auf die Seite unseres Buchungsanbieters weitergeleitet.</p>
        <Button href={site.bookingUrl} external>Jetzt Termin buchen</Button>
      </div>
    </div>
  </section>
</Base>
